{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deskdo",
  "version": "0.8.0",
  "identifier": "dev.deskdo.app",
  "build": {
    "beforeDevCommand": "npm run build:worker && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:worker && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://uapis.cn"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "TradChinese"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRENkRBNDI2OTgyRkNGN0IKUldSN3p5K1lKcVJ0VFJZcDNpU081emM3RW5ubG1jQWdJMUdVRWNabkVPZHZMbFFzeGRsMEVRNzQK",
      "endpoints": [
        "https://github.com/adaizaiganma/deskdo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
