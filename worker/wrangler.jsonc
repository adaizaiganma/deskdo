{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 名稱和設定精靈部署的相同（deskdo），所以 `npm run deploy` 會更新精靈建立的那個雲端
  "name": "deskdo",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // 判斷「今天」「逾期」用的時區
    "TIMEZONE": "Asia/Taipei"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deskdo",
      // 作者帳號裡的資料庫。用自己的帳號開發時，換成 `npx wrangler d1 list` 裡 deskdo 的 uuid
      "database_id": "a97c1cfe-743d-4d39-a24e-151fc1bda781",
      "migrations_dir": "migrations"
    }
  ]
  // 驗證用的 token 和 MCP 密鑰存在 D1（由設定精靈建立），不需要 wrangler secret。
  // 舊的 setup.ps1 部署方式才會用 `wrangler secret put API_TOKEN / MCP_SECRET`。
}
