{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 部署名稱沿用改名前的 todo-worker：改名會換掉 workers.dev 網址，claude.ai 連接器和密鑰都要重設
  "name": "todo-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // 判斷「今天」「逾期」用的時區
    "TIMEZONE": "Asia/Taipei"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "todo-db",
      // 部署前執行 `npx wrangler d1 create todo-db`，把輸出的 database_id 貼到這裡
      "database_id": "e0d09289-0c09-4fb1-b7ac-efdcdf6a737d",
      "migrations_dir": "migrations"
    }
  ]
  // 密鑰（不要寫在這裡）：
  //   npx wrangler secret put MCP_SECRET   -> 放在 /mcp/<MCP_SECRET> 網址中
  //   npx wrangler secret put API_TOKEN    -> 桌面小工具用的 Bearer token
}
