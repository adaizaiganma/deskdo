{
  "name": "deskdo-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/embed-web.mjs && wrangler dev",
    "deploy": "node scripts/embed-web.mjs --require && wrangler deploy",
    "bundle": "node scripts/embed-web.mjs --require && wrangler deploy --dry-run --outdir dist --minify",
    "typecheck": "node scripts/embed-web.mjs && tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply deskdo --local",
    "db:migrate:remote": "wrangler d1 migrations apply deskdo --remote"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.149.0"
  }
}
