<?xml version="1.0" encoding="utf-8"?>
<!-- 一筆待辦：圓圈、標題和小字（優先、標籤…）、右邊的期限倒數 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="44dp">

    <!-- 點圓圈完成 -->
    <ImageView
        android:id="@+id/check"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="10dp"
        android:src="@drawable/widget_check"
        android:contentDescription="@string/widget_complete" />

    <!-- 點文字打開 App -->
    <LinearLayout
        android:id="@+id/body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/widget_text"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/waiting"
                    style="@style/WidgetMeta"
                    android:drawableStart="@drawable/widget_ic_link"
                    android:textColor="@color/widget_faint" />

                <TextView
                    android:id="@+id/high"
                    style="@style/WidgetMeta"
                    android:drawableStart="@drawable/widget_ic_flag"
                    android:text="@string/widget_high"
                    android:textColor="@color/widget_warn" />

                <TextView
                    android:id="@+id/low"
                    style="@style/WidgetMeta"
                    android:text="@string/widget_low"
                    android:textColor="@color/widget_faint" />

                <TextView
                    android:id="@+id/tag"
                    style="@style/WidgetMeta"
                    android:ellipsize="end"
                    android:textColor="@color/widget_sub" />

                <TextView
                    android:id="@+id/mail"
                    style="@style/WidgetMeta"
                    android:drawableStart="@drawable/widget_ic_mail"
                    android:text="Gmail"
                    android:textColor="@color/widget_sub" />

                <TextView
                    android:id="@+id/note"
                    style="@style/WidgetMeta"
                    android:drawableStart="@drawable/widget_ic_note"
                    android:text="@string/widget_note"
                    android:textColor="@color/widget_sub" />
            </LinearLayout>
        </LinearLayout>

        <!-- 期限：上面是倒數（逾期 2 天／今天到期／還有 3 天），下面是日期 -->
        <LinearLayout
            android:id="@+id/due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_sub"
                android:fontFeatureSettings="tnum"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_faint"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
