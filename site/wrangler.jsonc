{
  // 宣傳網站：純靜態檔案，用 Workers static assets 部署（npx wrangler deploy）
  "$schema": "../worker/node_modules/wrangler/config-schema.json",
  "name": "deskdo-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    // /guide 對應 guide.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // 自訂網域：部署時 wrangler 會自動建立 DNS 記錄與憑證（網域要在同一個 Cloudflare 帳號）
  "routes": [{ "pattern": "deskdo.adaizaiganma.qzz.io", "custom_domain": true }],
  // 只用自訂網域，不開 deskdo-site.<子網域>.workers.dev
  "workers_dev": false
}
